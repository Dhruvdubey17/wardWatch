# Local-only defaults for the compose stack. Copy to .env to change them;
# .env is ignored by git. None of these are real credentials.
WARDWATCH_POSTGRES_PASSWORD=wardwatch_dev
WARDWATCH_GRAFANA_PASSWORD=wardwatch_dev
# Host port for the stack's Postgres (inside the stack it is always postgres:5432).
WARDWATCH_POSTGRES_HOST_PORT=15432
